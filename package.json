{
  "name": "react-gfmd",
  "version": "0.1.0",
  "description": "A package-first GitHub-flavored Markdown editor MVP for React and ProseMirror.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts && cp src/styles.css dist/styles.css",
    "build:demo": "vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "markdown",
    "gfm",
    "github",
    "prosemirror",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@handlewithcare/react-prosemirror": "^3.0.6",
    "prosemirror-model": "^1.25.7",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.7",
    "react": ">=17 <20",
    "react-dom": ">=17 <20",
    "react-reconciler": ">=0.26.1 <=0.33.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@handlewithcare/prosemirror-inputrules": "^0.1.4",
    "@handlewithcare/remark-prosemirror": "^0.1.5",
    "hast-util-from-html": "^2.0.3",
    "lucide-react": "^1.16.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-tables": "^1.8.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
